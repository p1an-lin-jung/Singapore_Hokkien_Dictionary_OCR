# ── build artefacts (regenerated by prepare_web.py / normalize_main.py etc.) ──

# per-page normalise backups
main_pages/*.bak
fanli_pages/*.bak
index_pages/*.bak
intro_pages/*.bak

# raw model responses (kept only during debugging)
main_pages/*.raw.txt
fanli_pages/*.raw.txt
index_pages/*.raw.txt
intro_pages/*.raw.txt

# obsolete yaml artefacts from earlier pipeline
*.yaml.BAK
*.yaml.bak

# dev-time bbox visualisation dumps
bbox_preview/

# dev-time page image mirror at repo root (redundant with _site/page_images/)
/page_images/

# ── python ──
__pycache__/
*.pyc
*.pyo

# ── editor / OS ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── logs ──
logs/
*.log
