{
  // Cloudflare 部署配置：本仓库本地构建 _site/，把它作为静态资源部署。
  // 若通过 Cloudflare Pages 面板部署，也可以在 "Build output directory"
  // 里直接填 `_site` 而不用这个文件。
  "$schema": "https://raw.githubusercontent.com/cloudflare/workerd/main/npm/wrangler/config-schema.json",
  "name": "singapore-hokkien-dictionary-ocr",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./_site"
  }
}
